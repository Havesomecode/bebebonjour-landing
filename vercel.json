{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/((?!delivery(?:/|$)|announcements/|interest/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/delivery",
      "destination": "https://api-production-c9013a1c.up.railway.app/delivery"
    },
    {
      "source": "/delivery/:path*",
      "destination": "https://api-production-c9013a1c.up.railway.app/delivery/:path*"
    },
    {
      "source": "/announcements/:path*",
      "destination": "https://api-production-c9013a1c.up.railway.app/announcements/:path*"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/interest/subscribe",
      "destination": "https://api-production-c9013a1c.up.railway.app/interest/subscribe"
    },
    {
      "source": "/interest/confirm",
      "destination": "https://api-production-c9013a1c.up.railway.app/interest/confirm"
    },
    {
      "source": "/interest/unsubscribe",
      "destination": "https://api-production-c9013a1c.up.railway.app/interest/unsubscribe"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
